{
  "vision": {
    "provider": "onnxruntime-web",
    "preferred_backend": "webgpu",
    "fallback_backend": "wasm",
    "face_detection": {
      "model_path": "models/face_detect.onnx",
      "input_dimensions": [1, 3, 320, 320],
      "confidence_threshold": 0.5,
      "heuristic_fallback": true
    }
  },
  "ocr": {
    "engine": "tesseract.js",
    "enabled": false,
    "local_only": true
  }
}
