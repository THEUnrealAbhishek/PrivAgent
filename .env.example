# PrivAgent Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM Configuration
# Set LLM_PROVIDER to "mock" for demo mode (no API key needed)
# Set to "openai", "google", or "anthropic" for real LLM
LLM_PROVIDER=mock

# OpenAI (optional - only if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional - only if LLM_PROVIDER=google)
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.0-flash

# Anthropic (optional - only if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# CORS - allowed origins (comma-separated)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
